# Plantilla para airflow/secrets/variables.yaml (archivo real ignorado por git).
# Copiar este archivo a variables.yaml y completar los valores reales.
#
# RUNPOD_API_KEY nunca va en .env: se lee en runtime vía Variable.get("RUNPOD_API_KEY")
# desde este secrets backend (AIRFLOW__SECRETS__BACKEND_KWARGS en docker-compose.yaml).
RUNPOD_API_KEY: "tu-runpod-api-key-aqui"
