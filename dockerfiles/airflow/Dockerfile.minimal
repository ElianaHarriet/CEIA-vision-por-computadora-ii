FROM apache/airflow:3.0.2

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
         git \
         libgl1-mesa-glx \
         libglib2.0-0 \
  && apt-get autoremove -yqq --purge \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

USER airflow
ENV PIP_DEFAULT_TIMEOUT=300
COPY requirements-minimal.txt /requirements-minimal.txt

RUN pip install --upgrade pip \
 && pip install --no-cache-dir --resume-retries 20 \
    apache-airflow[virtualenv]==3.0.2 -r /requirements-minimal.txt

# Las dependencias pesadas (torch, ultralytics) se instalarán en virtualenvs
# cuando los DAGs las necesiten, no en la imagen base
