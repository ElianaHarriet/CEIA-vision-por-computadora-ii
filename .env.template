# ============================================================
# Plantilla de variables de entorno (copiar a .env y completar)
#   cp .env.template .env
#
# .env es ignorado por git: no commitear valores reales acá.
# Las variables sin valor por defecto son obligatorias.
# ============================================================

# --- INFRAESTRUCTURA COMPARTIDA (DigitalOcean) ---
# MLflow y MinIO están en un servidor compartido del equipo
# Pedir la IP y credenciales a un miembro del equipo
MLFLOW_TRACKING_URI=http://PEDIR_IP_AL_EQUIPO:5001
MLFLOW_S3_ENDPOINT_URL=http://PEDIR_IP_AL_EQUIPO:9000
AWS_ENDPOINT_URL=http://PEDIR_IP_AL_EQUIPO:9000
AWS_ACCESS_KEY_ID=PEDIR_AL_EQUIPO
AWS_SECRET_ACCESS_KEY=PEDIR_AL_EQUIPO

# --- Roboflow (dataset) ---
# Pedir estos valores al equipo
ROBOFLOW_API_KEY=PEDIR_AL_EQUIPO
ROBOFLOW_WORKSPACE=PEDIR_AL_EQUIPO
ROBOFLOW_PROJECT=PEDIR_AL_EQUIPO
ROBOFLOW_VERSION=1

# --- RunPod (entrenamiento GPU) ---
# NOTA: El perfil activo se configura en airflow/config/.runpod-profile
# Cada persona debe poner su nombre en ese archivo: luis, santiago, o eliana

# Endpoints de RunPod (pedir al equipo)
RUNPOD_ENDPOINT_ID_SANTIAGO=PEDIR_AL_EQUIPO
RUNPOD_ENDPOINT_ID_LUIS=PEDIR_AL_EQUIPO

# Balance mínimo requerido en RunPod (en USD). Default: 2
RUNPOD_MIN_BALANCE=2

# Timeout total para el polling del job en RunPod (en segundos). Default: 10800 = 3 horas
RUNPOD_POLL_TIMEOUT_S=10800

# Intervalo entre cada consulta de status al job en RunPod (en segundos). Default: 45
RUNPOD_POLL_INTERVAL_S=45

# Las API keys y Docker Hub usernames NO van acá: se leen en runtime desde
# airflow/secrets/variables.yaml (ver ese archivo para más detalles)

# --- Hiperparámetros YOLO (tuning sin tocar código) ---
# Configuración mejorada: modelo Extra Large + más epochs + más paciencia
YOLO_MODEL=yolov8x-seg.pt
YOLO_EPOCHS=150
YOLO_IMG_SIZE=640
YOLO_BATCH_SIZE=16
YOLO_PATIENCE=20

# --- Hiperparámetros U-Net (tuning sin tocar código) ---
UNET_ENCODER=resnet50
UNET_ENCODER_WEIGHTS=imagenet
UNET_EPOCHS=60
UNET_IMG_SIZE=640
UNET_BATCH_SIZE=8
UNET_LR=0.0001
UNET_PATIENCE=10

# --- Evaluación ---
# Confianza mínima de detección del predictor YOLO. Con valores bajos (0.25)
# se detectan regiones falsas grandes que inflan el error de área.
YOLO_CONF=0.4

# --- Airflow / docker ---
AIRFLOW_UID=501
AIRFLOW_GID=0
AIRFLOW_PORT=8080
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_IMAGE_NAME=extending_airflow:latest

# --- MLflow ---
MLFLOW_PORT=5001
MLFLOW_EXPERIMENT_NAME=car-damage-segmentation
MODEL_NAME_INSTANCE=car-damage-instance-segmentation
MODEL_NAME_SEMANTIC=car-damage-semantic-segmentation
MODEL_STAGE=Production
MODEL_VERSION_INSTANCE=latest
MODEL_VERSION_SEMANTIC=latest

# --- MinIO / S3 ---
MINIO_ACCESS_KEY=minio
MINIO_SECRET_ACCESS_KEY=minio123
MINIO_PORT=9000
MINIO_PORT_UI=9001
MLFLOW_BUCKET_NAME=mlflow
DATA_REPO_BUCKET_NAME=data

# --- Postgres ---
PG_USER=airflow
PG_PASSWORD=airflow
PG_DATABASE=airflow
PG_PORT=5432

# --- Otros servicios ---
# Para apuntar el FastAPI local al MLflow/MinIO de DigitalOcean alcanza con
# setear MLFLOW_TRACKING_URI=http://24.144.120.67:5001 /
# MLFLOW_S3_ENDPOINT_URL=http://24.144.120.67:9000 arriba en este mismo .env.
FASTAPI_PORT=8800

# --- Demo Gradio ---
# Host donde corre el FastAPI al que la demo le pega. Para consumir el FastAPI
# desplegado en DigitalOcean, poner la IP del servidor (ej. 24.144.120.67).
# Para consumir un FastAPI local, dejar en localhost.
FASTAPI_HOST=localhost
# Alternativamente, se puede overridear la URL completa (tiene prioridad):
# FASTAPI_URL=http://24.144.120.67:8800
DEMO_PORT=7860
